@APIURL=http://localhost:3001/api

###
### Authentication APIs
###

// Log In
POST {{APIURL}}/auth/login HTTP/1.1
Content-Type: application/json

{
    "username": "user1",
    "password": "password1"
}

###

// Log Out
POST {{APIURL}}/auth/logout HTTP/1.1

###



###
### Game APIs
###

// Start Game
POST {{APIURL}}/game/start HTTP/1.1

###

// Submit Answer
POST {{APIURL}}/game/answer HTTP/1.1
Content-Type: application/json

{
    "gameId": 1,
    "memeId": 1,
    "captionId": 1,
    "timeTaken": 12
}

###


###
### Profile APIs
###

// Get Profile Summary for Logged-in User
GET {{APIURL}}/profile/me HTTP/1.1

###


###
### User Info APIs
###

// Get User Info
GET {{APIURL}}/auth/user HTTP/1.1

